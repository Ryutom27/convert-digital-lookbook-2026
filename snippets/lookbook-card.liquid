{%- comment -%}
  Renders one lookbook: cover image/title/description from a `lookbook` metaobject,
  alongside a shoppable row of the products featured in it. Product data (price,
  image, variants) is deliberately not resolved here — only .handle is read from
  the metaobject's product references. The `lookbook-component` custom element
  fetches live product data from the Storefront API client-side, so market-based
  pricing (AUD/JPY) resolves correctly per shopper.

  Shared by sections/lookbook.liquid (merchant-picked lookbook) and
  sections/lookbook-featured-in.liquid (product-page reverse lookup), so the
  rendering and styling live in one place.

  @param {object} lookbook - a `lookbook` metaobject
  @see assets/lookbook.js

  @example
  {% render 'lookbook-card', lookbook: lookbook %}
{%- endcomment -%}

<script
  src="{{ 'lookbook.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign products = lookbook.products.value
  assign product_handles = products | map: 'handle' | join: ','
%}

<lookbook-component
  class="lookbook__wrapper"
  data-product-handles="{{ product_handles }}"
  data-country="{{ localization.country.iso_code }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-storefront-token="{{ settings.storefront_access_token }}"
>
  <div class="lookbook__grid">
    <div class="lookbook__media">
      {% if lookbook.image.value != blank %}
        {% render 'image', image: lookbook.image.value, class: 'lookbook__image' %}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook__image lookbook__image--placeholder' }}
      {% endif %}
    </div>

    <div class="lookbook__content sticky-content--desktop">
      {% if lookbook.title.value != blank %}
        <h2 class="lookbook__title h3">{{ lookbook.title.value }}</h2>
      {% endif %}

      {% if lookbook.description.value != blank %}
        <div class="lookbook__description">{{ lookbook.description.value | newline_to_br }}</div>
      {% endif %}

      {% if products.size > 0 %}
        <p class="lookbook__shop-label">Shop this look</p>
        <ul class="lookbook__thumbs" ref="thumbList" role="list">
          {% for product in products %}
            <li
              class="lookbook__thumb lookbook__thumb--loading"
              data-handle="{{ product.handle }}"
              aria-hidden="true"
            ></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>

  <template ref="thumbIconTemplate">
    <span class="lookbook__thumb-icon" aria-hidden="true">
      {{ 'icon-plus.svg' | inline_asset_content }}
    </span>
  </template>

  <dialog
    class="lookbook__dialog"
    ref="dialog"
    aria-label="{{ 'accessibility.product_details' | t }}"
  ></dialog>
</lookbook-component>

{% stylesheet %}
  .lookbook__wrapper {
    display: block;
  }

  /* Without this, sticky-content--desktop's top offset defaults to 0 (see
     assets/base.css) and sticks right under/behind the header instead of
     below it — same fix product-information-content.liquid applies to the
     product page's sticky buy-box. */
  body:has(#header-group #header-component[data-sticky-state='active'])
    .lookbook__content.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  .lookbook__grid {
    display: flex;
    flex-direction: column;
    gap: var(--margin-lg, 24px);

    /* Flex, not grid: position: sticky on a grid item is inconsistently
       supported across browsers (notably Safari); it's much more reliable
       as a flex item, which is why the layout uses flex here instead of
       the grid technique media-with-content.liquid uses elsewhere. */
    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .lookbook__media {
    @media screen and (min-width: 750px) {
      flex: 0 0 calc((100% / 12) * 7);
    }
  }

  .lookbook__image,
  .lookbook__image--placeholder {
    width: 100%;
    height: auto;
    display: block;
  }

  .lookbook__content {
    display: flex;
    flex-direction: column;
    gap: var(--margin-sm, 12px);

    @media screen and (min-width: 750px) {
      flex: 0 0 calc((100% / 12) * 5);
    }
  }

  .lookbook__description {
    color: var(--color-foreground-subdued);
  }

  .lookbook__shop-label {
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-subdued);
    margin-block-start: var(--margin-sm, 12px);
  }

  .lookbook__thumbs {
    display: flex;
    gap: var(--margin-xs, 8px);
    overflow-x: auto;
    padding: 0;
    margin: 0;
    list-style: none;
    scroll-snap-type: x proximity;

    /* Hide scrollbar, matches theme convention (see localization-form.liquid) */
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .lookbook__thumb {
    position: relative;
    flex: 0 0 auto;
    width: 92px;
    aspect-ratio: 3 / 4;
    scroll-snap-align: start;
    border-radius: var(--style-border-radius-buttons, 4px);
    cursor: pointer;
    background: none;
    padding: 0;
    border: 0;
    overflow: hidden;
  }

  .lookbook__thumb--loading {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8, 0.08));
    animation: lookbook-pulse 1.4s ease-in-out infinite;
  }

  .lookbook__thumb-button {
    all: unset;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .lookbook__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lookbook__thumb-icon {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: #000;
    pointer-events: none;
  }

  .lookbook__thumb-icon svg {
    width: 10px;
    height: 10px;
  }

  @keyframes lookbook-pulse {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.5;
    }
  }

  .lookbook__dialog {
    position: relative;
    padding: 0;
    border: 0;
    border-radius: var(--style-border-radius-buttons, 4px);
    max-width: 320px;
  }

  .lookbook__dialog::backdrop {
    background: rgb(0 0 0 / 0.3);
  }

  .lookbook__dialog-close {
    position: absolute;
    top: var(--margin-xs, 8px);
    right: var(--margin-xs, 8px);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.9);
    color: #000;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  .lookbook__dialog-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .lookbook__dialog-content {
    display: flex;
    flex-direction: column;
    gap: var(--margin-xs, 8px);
    padding: var(--margin-md, 16px);
  }

  .lookbook__dialog-title {
    font-weight: 500;
  }

  .lookbook__dialog-compare-at {
    color: var(--color-foreground-subdued);
  }

  .lookbook__dialog-variant-select {
    width: 100%;
  }

  .lookbook__dialog-error {
    color: var(--color-error, #d02e2e);
    font-size: var(--font-size-sm);
  }
{% endstylesheet %}
